{
  "expo": {
    "name": "campus-watch",
    "slug": "campus-watch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuswatch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "autolinking": {
      "exclude": ["react-native-ble-plx"]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CampusWatch uses Bluetooth briefly to detect nearby app users during incidents. Tokens rotate every 15 minutes and are never stored long-term.",
        "NSBluetoothPeripheralUsageDescription": "CampusWatch uses Bluetooth briefly to help deliver nearby incident alerts. No personal identity is broadcast."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "package": "com.alexmozeyu2011.campuswatch"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusWatch needs your location to show where incidents are happening on campus.",
          "locationAlwaysAndWhenInUsePermission": "CampusWatch needs your location to show where incidents are happening on campus."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563eb",
          "defaultChannel": "campus-alerts",
          "sounds": [
            "./assets/sounds/alert.wav",
            "./assets/sounds/comment.wav",
            "./assets/sounds/like_notification.wav",
            "./assets/sounds/success.wav",
            "./assets/sounds/tap.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CampusWatch needs camera access for instant photo incident reporting.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withGradleFixes"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a77cb3d-528b-43ba-842f-3a34fb6c6070"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0a77cb3d-528b-43ba-842f-3a34fb6c6070",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
